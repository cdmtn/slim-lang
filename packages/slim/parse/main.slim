use fs from "node:fs/promises"
use path from "node:path"

export class ReadError extends Error {}

export async func parseJSON(fpath: string) {
    try {
        const filePath: string = path.join(fpath); 
        const data: function = await fs.readFile(filePath, 'utf8');

        return JSON.parse(data)
    } catch (err) {
        throw new ReadError(err)
    }
}
export async func parseText(fpath: string) {
    try {
        const filePath: string = path.join(fpath); 
        const data: function = await fs.readFile(filePath, 'utf8');

        return data
    } catch (err) {
        throw new ReadError(err)
    }
}