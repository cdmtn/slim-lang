import http from "http";

export type ServerInstance = typeof Server;

class Server {
    constructor(port: int = 3000) {
        this.port = port;
        this.routes = {};
        this.clients = [];
    }

	page(path: string, render: function, options: object) {
		let additionalScript = ""

		func renderTag(content: string[]) {
			const tags: object = {
				"css": {
					tag: "link",
					attr: "href"
				},
				"js": {
					tag: "script",
					attr: "src"
				},
			}

			content.forEach(c => {
				const r = Math.floor(Math.random() + 1) * 999
				const ext = c.split(".").pop()

				if (ext in tags) {
					const tag = tags[ext].tag
					const attr = tags[ext].attr
					const varName = `${tag}_${r}`

					additionalScript += `
						const ${varName} = document.createElement("${tag}");\n
						${varName}.${attr} = "${c}";
						document.head.appendChild(${varName});
					`
				}
			})
		}

		if ("head" in options) {
			renderTag(options.head)
		}
		if ("title" in options) {
			additionalScript += `document.title = "${options.title}";`
		}

        this.get(path, (req, res) => {
            const isDev = process.env.SLIM_DEV === "1"
			let html = render({ dev: isDev });

            if (isDev) {
                html += `
                <script>
                    (function () {
                        let connectedBefore = false;

                        const es = new EventSource("/__slim_reload__");

                        es.onopen = () => {
                            if (connectedBefore) {
                                location.reload();
                                return;
                            }
                            connectedBefore = true;
                        };

                        ${additionalScript};
                    })();
                </script>`;
            }

            res.writeHead(200, {
                "Content-Type": "text/html; charset=utf-8",
                "Cache-Control": "no-store"
            });

            res.end(html);
        });
    }

    get(path: string, callback: function) {
        this.routes[path] = callback;
    }

    start() {
        this.get("/__slim_reload__", (req, res) => {
            res.writeHead(200, {
                "Content-Type": "text/event-stream",
                "Cache-Control": "no-cache",
                "Connection": "keep-alive"
            });

            res.write("retry: 300\n\n");

            this.clients.push(res);

            req.on("close", () => {
                this.clients = this.clients.filter(x => x !== res);
            });
        });

        http.createServer((req, res) => {
            const route = this.routes[req.url];

            if (route) {
                route(req, res);
                return;
            }

            res.writeHead(404);
            res.end("404");
        }).listen(this.port);

        log(`http://localhost:${this.port}`);
    }
}

export { Server };