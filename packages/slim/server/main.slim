use http from "http"
use * as fs from "fs"
use * as nodePath from "path"
use { fileURLToPath } from "url"
import process from 'node:process';

export type ServerInstance = typeof Server;

export struct RedirectRoute {
    from: string
    to: string
}

export struct StaticRoute {
    from: string
    to: string
}

export struct SlimServerConf {
    port: int = 3000
    dev: bool = false
    redirects: object[] = [{}]
    statics: object[] = [{}]
}

class Server {
    constructor(port: int = 3000) {
        this.port = port;
        this.routes = [];
        this.apiRoutes = {};
        this.clients = [];
        this.staticDirs = [];
        this.dev = false;
        this.clientPrefix = "/@slim";
        this.distDir = null;
        this.httpServer = null;
        this.shutdownInstalled = false;

        this.#loadConfig();
    }

    #loadConfig() {
        let configDir = process.cwd();
        let raw: object = {};
        let distName = "slim-dist";

        try {
            const slimConf = JSON.parse(fs.readFileSync(nodePath.join(process.cwd(), "slimconfig.json"), "utf8"));
            if (slimConf.main) configDir = nodePath.dirname(nodePath.resolve(slimConf.main));
            if (slimConf.names && slimConf.names.dist) distName = slimConf.names.dist;
            else if (slimConf.dist) distName = slimConf.dist;
        } catch (e) {}

        try {
            raw = JSON.parse(fs.readFileSync(nodePath.join(configDir, "slimserver.json"), "utf8"));
        } catch (e) {}

        const conf = SlimServerConf.new(raw);

        this.port = conf.port;
        this.dev = conf.dev || process.env.SLIM_DEV === "1";

        this.redirect(conf.redirects);

        const statics = conf.statics.map(entry => {
            if (empty entry) return entry;
            return { from: entry.from, to: nodePath.resolve(configDir, entry.to) };
        });

        this.static(statics);

        this.#mountClient(distName);
    }

    #mountClient(distName: string) {
        const distDir = nodePath.resolve(process.cwd(), distName);

        this.distDir = distDir;

        if (fs.existsSync(distDir)) {
            this.staticDirs.push({ prefix: this.clientPrefix, dir: distDir });
        }
    }

    #resolveHydrate(entry: string) {
        if (entry.startsWith("/") || entry.startsWith("http")) return entry;

        const modulePath = entry.endsWith(".js") ? entry : `${entry}.js`;
        return `${this.clientPrefix}/${modulePath}`;
    }

    #hydrateBootstrap(hydrate) {
        // Component reference → derive its module + export name automatically.
        // Every compiled component carries `__module__` (its own import.meta.url).
        if (typeof hydrate === "function") {
            const name = hydrate.name;
            const moduleUrl = this.#clientUrlFor(hydrate.__module__);

            if (empty name || empty moduleUrl) {
                throw new Error("hydrate: component must be a named export compiled by Slim");
            }

            return this.#inlineBootstrap(moduleUrl, name);
        }

        // Absolute/external entry → load it as a module (custom bootstrap escape hatch).
        if (hydrate.startsWith("/") || hydrate.startsWith("http")) {
            return `<script type="module" src="${hydrate}"></script>`;
        }

        // "module/path:Export" → generate the client bootstrap inline. The component is
        // already compiled (the server imports it), so no client entry file is needed.
        if (hydrate.includes(":")) {
            const parts = hydrate.split(":");
            return this.#inlineBootstrap(`${this.clientPrefix}/${parts[0]}.js`, parts[1]);
        }

        // Bare module path → a hand-written client entry compiled to <path>.js.
        return `<script type="module" src="${this.#resolveHydrate(hydrate)}"></script>`;
    }

    // Map a compiled module's import.meta.url to its served /@slim/... URL.
    #clientUrlFor(moduleUrl: string) {
        if (empty moduleUrl || empty this.distDir) return null;

        const filePath = moduleUrl.startsWith("file:") ? fileURLToPath(moduleUrl) : moduleUrl;
        const rel = nodePath.relative(this.distDir, filePath).split(nodePath.sep).join("/");

        if (empty rel || rel.startsWith("..")) return null;

        return `${this.clientPrefix}/${rel}`;
    }

    #inlineBootstrap(moduleUrl: string, name: string) {
        const coreUrl = `${this.clientPrefix}/external/core.js`;

        return `<script type="module">` +
            `import "${coreUrl}";` +
            `import { ${name} } from "${moduleUrl}";` +
            `hydrate(() => ${name}(), document.getElementById("slim-root"));` +
            `</script>`;
    }

	page(path: string, render: function, options?: object) {
		let additionalScript = ""
		let scriptId = 0;

		func renderTag(content: string[]) {
			const tags: object = {
				"css": {
					tag: "link",
					attr: "href",
					additionalAttrs: {
						rel: "stylesheet"
					}
				},
				"js": {
					tag: "script",
					attr: "src"
				},
			}

			content.forEach(c => {
			    const ext = c.split(".").pop();

			    if (ext in tags) {
			     	const tag = tags[ext].tag;
				    const attr = tags[ext].attr;
					const varName = `${tag}_${scriptId++}`;
					let additional = ""

					if ("additionalAttrs" in tags[ext]) {
						const additionalAttrs = tags[ext].additionalAttrs

						Object.keys(additionalAttrs).forEach(e => {
							additional += `${varName}.${e} = "${additionalAttrs[e]}"`
						})
					}

				    additionalScript += `
			       		const ${varName} = document.createElement("${tag}");
						${varName}.${attr} = ${JSON.stringify(c)};
						${additional}
			        	document.head.appendChild(${varName});
					`;
			    }
			});
		}

        if(options) {
            if ("head" in options) {
                const headLinks: string[] = options.head

                renderTag(headLinks)
            }
            if ("title" in options) {
                const title: string = options.title

                additionalScript += `document.title = "${title}";`
            }
            if ("icon" in options) {
                const icon: string = options.icon

                additionalScript += `
                    link = document.createElement("link");
                    link.rel = "icon";
                    link.href = "${icon}";
                    document.head.appendChild(link);
                `
            }
            if ("onload" in options) {
                const onload: function = options.onload

                additionalScript += `
                    const __onload = ${String(onload)};__onload({ port: ${this.port}});
                `
            }
        }

        this.get(path, async (req, res, params) => {
            const isDev = this.dev
            let html = null

            if (options && "hydrate" in options) {
                const props = { dev: isDev, params, url: req.url }
                let initialStore = null
                if ("load" in options && typeof options.load == "function") {
                    initialStore = await options.load(props)
                }
                const rendered = await renderToStringAsync(() => render(props), { store: initialStore })
                const data = JSON.stringify(props).replace(/</g, "\\u003c")
                const bootstrap = this.#hydrateBootstrap(options.hydrate)
                html = `<div id="slim-root">${rendered.html}</div>` + rendered.script +
                    `<script>window.__slimProps = ${data}</script>` +
                    bootstrap
            } else {
                html = render({ dev: isDev, params, url: req.url })
            }
			const eventsScript = __flush_events__();

            if(kindof html == "promise") {
                html = await html
            }

            if(kindof html == "object") {
                res.writeHead(200, {
                    "Content-Type": "text/json; charset=utf-8",
                    "Cache-Control": "no-store"
                });
                res.end(JSON.stringify(html))

                return
            }

			html += `<script>`

			html += additionalScript

            if (isDev) {
                html += `
                    (function () {
                        let connectedBefore = false;

                        const es = new EventSource("/__slim_reload__");

                        es.onopen = () => {
                            if (connectedBefore) {
                                location.reload();
                                return;
                            }
                            connectedBefore = true;
                        };
                    })();`;
			}

            html += `</script>`

            if (eventsScript) {
                html += `<script>${eventsScript}</script>`
            }

            res.writeHead(200, {
                "Content-Type": "text/html; charset=utf-8",
                "Cache-Control": "no-store"
            });

            res.end(html);
        });
    }

    get(path: string, callback: function) {
        const compiled = this.compileRoute(path);
        this.routes.push({ regex: compiled.regex, keys: compiled.keys, callback });
    }

    escapeRegex(str: string) {
        const specials = ".^$*+?()[]{}|\\";
        let out = "";

        for (const ch of str) {
            if (specials.includes(ch)) out += "\\";
            out += ch;
        }

        return out;
    }

    compileRoute(route: string) {
        const keys = [];

        const pattern = route.split("/").map(segment => {
            if (segment.length > 2 && segment.startsWith("{") && segment.endsWith("}")) {
                keys.push(segment.slice(1, -1));
                return "([^/]+)";
            }

            return this.escapeRegex(segment);
        }).join("/");

        return { regex: new RegExp("^" + pattern + "$"), keys };
    }

    contentType(file: string) {
        const types: object = {
            html: "text/html",
            css: "text/css",
            js: "text/javascript",
            mjs: "text/javascript",
            json: "application/json",
            svg: "image/svg+xml",
            png: "image/png",
            jpg: "image/jpeg",
            jpeg: "image/jpeg",
            gif: "image/gif",
            webp: "image/webp",
            ico: "image/x-icon",
            woff: "font/woff",
            woff2: "font/woff2",
            ttf: "font/ttf",
            txt: "text/plain"
        };

        const ext = file.split(".").pop().toLowerCase();
        const mime = types[ext] ?? "application/octet-stream";
        const isText = mime.startsWith("text/") || mime == "application/json" || mime == "image/svg+xml";

        return isText ? `${mime}; charset=utf-8` : mime;
    }

    colorStatus(status: int) {
        const text = String(status);

        if (!process.stdout.isTTY) return text;

        const esc = String.fromCharCode(27);
        let color = "32";

        if (status >= 500) color = "31";
        else if (status >= 400) color = "33";
        else if (status >= 300) color = "36";

        return `${esc}[${color}m${text}${esc}[0m`;
    }

    api(path: string, handler: function) {
        this.apiRoutes[path] = handler;
    }

    redirect(paths: object[]) {
        for(const path of paths) {
            if(empty path) continue

            RedirectRoute.verify(path)

            const from = path.from
            const to = path.to

            this.get(from, async (req, res) => {
                res.writeHead(200, {
                    "Content-Type": "text/html; charset=utf-8",
                    "Cache-Control": "no-store"
                });

                res.end(`<script>window.location.href="${to}"</script>`);
            })
        }
    }

    static(paths: object[]) {
        for(const path of paths) {
            if(empty path) continue

            StaticRoute.verify(path)

            const from = path.from
            const to = path.to

            const root = nodePath.resolve(to);

            if (!fs.existsSync(root)) {
                log(`[SlimServer] Static setup ("${from}" -> "${to}"): directory not found: ${to}`);
            }

            this.staticDirs.push({ prefix: from, dir: to });
        }
    }

    start() {
        this.get("/__slim_reload__", (req, res) => {
            res.writeHead(200, {
                "Content-Type": "text/event-stream",
                "Cache-Control": "no-cache",
                "Connection": "keep-alive"
            });

            res.write("retry: 300\n\n");

            this.clients.push(res);

            req.on("close", () => {
                this.clients = this.clients.filter(x => x !== res);
            });
        });

        this.httpServer = http.createServer((req, res) => {
            const url = req.url.split("?")[0];

            if (this.dev && url != "/__slim_reload__") {
                const started = Date.now();

                res.on("finish", () => {
                    const ms = Date.now() - started;
                    log(`${req.method} ${req.url} ${this.colorStatus(res.statusCode)} in ${ms}ms`);
                });
            }

            for (const route of this.routes) {
                const match = url.match(route.regex);

                if (match) {
                    const params: object = {};
                    route.keys.forEach((key, i) => {
                        params[key] = decodeURIComponent(match[i + 1]);
                    });

                    route.callback(req, res, params);
                    return;
                }
            }

            const apiRoute = this.apiRoutes[url];

            if (apiRoute) {
                let body = "";
                req.on("data", chunk => { body += chunk });
                req.on("end", async () => {
                    let data = null;

                    if (body) {
                        try {
                            data = JSON.parse(body);
                        } catch (e) {
                            res.writeHead(400, { "Content-Type": "application/json" });
                            res.end(JSON.stringify({ error: "Invalid JSON body" }));
                            return;
                        }
                    }

                    try {
                        const result = await apiRoute(data, req);
                        res.writeHead(200, { "Content-Type": "application/json" });
                        res.end(JSON.stringify(result ?? null));
                    } catch (e) {
                        res.writeHead(500, { "Content-Type": "application/json" });
                        res.end(JSON.stringify({ error: e && e.message ? e.message : String(e) }));
                    }
                });
                return;
            }

            for (const mount of this.staticDirs) {
                if (url == mount.prefix || url.startsWith(mount.prefix + "/")) {
                    let relative = url.slice(mount.prefix.length);
                    while (relative.startsWith("/")) relative = relative.slice(1);

                    const root = nodePath.resolve(mount.dir);
                    const filePath = nodePath.join(root, relative);

                    if (filePath != root && !filePath.startsWith(root + nodePath.sep)) {
                        res.writeHead(403);
                        res.end("403");
                        return;
                    }

                    fs.promises.readFile(filePath).then(data => {
                        res.writeHead(200, {
                            "Content-Type": this.contentType(filePath),
                            "Cache-Control": "no-store"
                        });
                        res.end(data);
                    }).catch(() => {
                        res.writeHead(404);
                        res.end("404");
                    });

                    return;
                }
            }

            res.writeHead(404);
            res.end("404");
        });

        this.httpServer.on("error", (err) => {
            if (err && err.code == "EADDRINUSE") {
                error(`Port ${this.port} is already in use — another server (or a previous run) is still holding it.`);
                process.exit(1);
            }
            throw err;
        });

        this.httpServer.listen(this.port, () => {
            log(`http://localhost:${this.port}`);
        });

        this.#installShutdown();
    }

    // Close the HTTP server and release its port. Safe to call more than once.
    stop() {
        for (const res of this.clients) {
            try { res.end(); } catch (e) {}
        }
        this.clients = [];

        if (this.httpServer) {
            // Drop keep-alive connections (e.g. the dev reload stream) so the
            // socket is freed immediately instead of lingering.
            if (typeof this.httpServer.closeAllConnections == "function") {
                this.httpServer.closeAllConnections();
            }
            this.httpServer.close();
            this.httpServer = null;
        }
    }

    // Stop cleanly on Ctrl+C / termination signals so the port is freed on exit.
    #installShutdown() {
        if (this.shutdownInstalled) return;
        this.shutdownInstalled = true;

        const shutdown = () => {
            this.stop();
            process.exit(0);
        };

        process.on("SIGINT", shutdown);
        process.on("SIGTERM", shutdown);
    }
}

export { Server };