
log(sizeof [1, 2, 3]) // 3
log(sizeof { key: "value" }) // 1


log(empty []) // true
log(empty {}) // true
log(empty null) // true
log(empty [1, 2, 3]) // false


log(kindof []) // null[]
log(kindof [1, 2, 3]) // int[]
log(kindof null) // null
log(kindof [1, "hello"]) // array
log(kindof 1.5) // float


const a = { name: "John" }
lock a;

try { Object.assign(a, { name: "Arthur" }) } catch (e) { log(e.message) } // Cannot assign to read only property 'name'


lock const b = { name: "John" }
try { Object.assign(b, { name: "Mike" }) } catch (e) { log(e.message) } // locked object mutation
