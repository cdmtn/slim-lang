use http from "http"
use * as fs from "fs"
use * as nodePath from "path"
use { fileURLToPath } from "url"
import process from 'node:process';

export type ServerInstance = typeof Server;

export struct RedirectRoute {
    from: string
    to: string
}

export struct StaticRoute {
    from: string
    to: string
}

export struct SlimServerConf {
    port: int = 3000
    dev: bool = false
    redirects: object[] = [{}]
    statics: object[] = [{}]
    bodyLimit: int = 1048576
}

class Server {
    constructor(port: int = 3000) {
        this.port = port;
        this.routes = [];
        this.apiRoutes = {};
        this.clients = [];
        this.staticDirs = [];
        this.dev = false;
        this.clientPrefix = "/@slim";
        this.clientManifest = ".slim-clients.json";
        this.manifestCache = null;
        this.hydratedRoots = new Set();
        this.bodyLimit = 1048576;
        this.distDir = null;
        this.httpServer = null;
        this.shutdownInstalled = false;

        this.#loadConfig();
    }

    #readConfigFile(file: string) {
        let text = null;

        try {
            text = fs.readFileSync(file, "utf8");
        } catch (e) {
            if (e && e.code == "ENOENT") return null;
            throw new Error(`[SlimServer] Can't read ${file}: ${e && e.message ? e.message : e}`);
        }

        if (text.charCodeAt(0) == 0xFEFF) text = text.slice(1);

        try {
            return JSON.parse(text);
        } catch (e) {
            throw new Error(`[SlimServer] ${file} is not valid JSON: ${e && e.message ? e.message : e}`);
        }
    }

    #loadConfig() {
        let configDir = process.cwd();
        let distName = "slim-dist";

        const slimConf = this.#readConfigFile(nodePath.join(process.cwd(), "slimconfig.json"));

        if (slimConf && typeof slimConf == "object") {
            if (typeof slimConf.main == "string" && slimConf.main.trim()) configDir = nodePath.dirname(nodePath.resolve(slimConf.main));
            const names = slimConf.names && typeof slimConf.names == "object" ? slimConf.names : {};
            const dist = names.dist ?? slimConf.dist;
            if (typeof dist == "string" && dist.trim()) distName = dist;
        }

        const raw: object = this.#readConfigFile(nodePath.join(configDir, "slimserver.json")) ?? {};

        const conf = SlimServerConf.new(raw);

        this.port = conf.port;
        this.dev = conf.dev || process.env.SLIM_DEV === "1";
        this.bodyLimit = conf.bodyLimit;

        this.redirect(conf.redirects);

        const statics = conf.statics.map(entry => {
            if (empty entry) return entry;
            return { from: entry.from, to: nodePath.resolve(configDir, entry.to) };
        });

        this.static(statics);

        this.#mountClient(distName);
    }

    #mountClient(distName: string) {
        this.distDir = nodePath.resolve(process.cwd(), distName);
        this.staticDirs.push({ prefix: this.clientPrefix, dir: this.distDir, client: true });
    }

    #clientManifestData() {
        const file = nodePath.join(this.distDir, this.clientManifest);
        let stamp = "missing";

        try {
            const stat = fs.statSync(file);
            stamp = `${stat.mtimeMs}:${stat.size}`;
        } catch (e) {
            if (!e || e.code != "ENOENT") stamp = `unreadable:${e && e.code ? e.code : e}`;
        }

        if (this.manifestCache && this.manifestCache.stamp == stamp) return this.manifestCache;

        const data: object = { stamp, files: new Set(), graph: new Map(), allowed: null, roots: -1, error: null };

        if (stamp != "missing") {
            try {
                const parsed = this.#readConfigFile(file);

                if (!parsed || typeof parsed != "object" || !Array.isArray(parsed.files)) {
                    throw new Error(`[SlimServer] ${file} has no "files" list. Build the project again`);
                }

                data.files = new Set(parsed.files.filter(name => typeof name == "string"));

                if (parsed.graph && typeof parsed.graph == "object") {
                    for (const name of Object.keys(parsed.graph)) {
                        const deps = parsed.graph[name];
                        data.graph.set(name, Array.isArray(deps) ? deps.filter(dep => typeof dep == "string") : []);
                    }
                }
            } catch (e) {
                data.error = e;
                error(e && e.message ? e.message : String(e));
            }
        }

        this.manifestCache = data;
        return data;
    }

    #allowedClientFiles() {
        const data = this.#clientManifestData();

        if (data.error) throw data.error;
        if (data.allowed && data.roots == this.hydratedRoots.size) return data.allowed;

        const allowed = new Set(data.files);
        const visited = new Set();
        const pending = [...this.hydratedRoots];

        while (pending.length > 0) {
            const current = pending.pop();
            if (current === undefined || visited.has(current)) continue;

            visited.add(current);
            allowed.add(current);

            for (const dep of data.graph.get(current) ?? []) pending.push(dep);
        }

        data.allowed = allowed;
        data.roots = this.hydratedRoots.size;
        return allowed;
    }

    #safeRel(rel: string) {
        if (empty rel) return false;

        return !rel.split("/").some(part => part.startsWith(".") || part == "");
    }

    #isClientFile(rel: string) {
        if (!this.#safeRel(rel)) return false;

        const parts = rel.split("/");

        if (parts[0] == "external" && parts.length > 1) return true;

        const allowed = this.#allowedClientFiles();

        return allowed.has(rel) || (rel.endsWith(".js.map") && allowed.has(rel.slice(0, -4)));
    }

    #requireClientFile(rel: string, what: string) {
        if (this.#safeRel(rel) && rel.startsWith("external/")) return;

        const data = this.#clientManifestData();

        if (data.error) throw data.error;

        if (!this.#safeRel(rel) || !rel.endsWith(".js") || (!data.graph.has(rel) && !data.files.has(rel))) {
            throw new Error(`hydrate: ${what} was not found in the build (${this.clientPrefix}/${rel}). Build the project, or add its .slim source to "clients" in slimconfig.json if nothing imports it`);
        }

        this.hydratedRoots.add(rel);
        data.allowed = null;
    }

    #scriptString(value) {
        return JSON.stringify(String(value)).replace(/</g, "\\u003c");
    }

    #attribute(value) {
        return String(value).replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    #isExternalUrl(value: string) {
        return /^https?:\/\//i.test(value);
    }

    #hydrateBootstrap(hydrate) {
        if (typeof hydrate === "function") {
            const name = hydrate.name;
            const rel = this.#clientRel(hydrate.__module__);

            if (empty name || empty rel) {
                throw new Error("hydrate: component must be a named export compiled by Slim");
            }

            this.#requireClientFile(rel, `component "${name}" (${rel})`);

            return this.#inlineBootstrap(`${this.clientPrefix}/${rel}`, name);
        }

        if (typeof hydrate !== "string" || empty hydrate) return "";

        if (this.#isExternalUrl(hydrate)) {
            return `<script type="module" src="${this.#attribute(hydrate)}"></script>`;
        }

        if (hydrate.startsWith("/")) {
            if (hydrate.startsWith(this.clientPrefix + "/")) {
                this.#requireClientFile(hydrate.slice(this.clientPrefix.length + 1), `"${hydrate}"`);
            }
            return `<script type="module" src="${this.#attribute(hydrate)}"></script>`;
        }

        if (hydrate.includes(":")) {
            const at = hydrate.lastIndexOf(":");
            const modulePath = hydrate.slice(0, at).replace(/\.js$/, "");
            const name = hydrate.slice(at + 1);
            const rel = `${modulePath}.js`;

            this.#requireClientFile(rel, `"${hydrate}"`);

            return this.#inlineBootstrap(`${this.clientPrefix}/${rel}`, name);
        }

        const rel = hydrate.endsWith(".js") ? hydrate : `${hydrate}.js`;

        this.#requireClientFile(rel, `"${hydrate}"`);

        return `<script type="module" src="${this.#attribute(`${this.clientPrefix}/${rel}`)}"></script>`;
    }

    async #runLoaders(load, props) {
        const loaders = Array.isArray(load) ? load : [load];
        const results = await Promise.all(loaders.map(fn => typeof fn == "function" ? fn(props) : fn));
        const store = {};

        results.forEach((result, i) => {
            if (result == null) return;

            if (typeof result != "object" || Array.isArray(result)) {
                const label = loaders[i] && loaders[i].name ? loaders[i].name : `load[${i}]`;
                warn(`${label} must return a plain object of store keys (JSON data), got ${typeof result} — ignored.`);
                return;
            }

            Object.assign(store, result);
        });

        return store;
    }

    #clientRel(moduleUrl: string) {
        if (empty moduleUrl || empty this.distDir) return null;

        const filePath = moduleUrl.startsWith("file:") ? fileURLToPath(moduleUrl) : moduleUrl;
        const rel = nodePath.relative(this.distDir, filePath).split(nodePath.sep).join("/");

        if (empty rel || rel.startsWith("..") || nodePath.isAbsolute(rel)) return null;

        return rel;
    }

    #inlineBootstrap(moduleUrl: string, name: string) {
        if (!/^[A-Za-z_$][A-Za-z0-9_$]*$/.test(name)) {
            throw new Error(`hydrate: "${name}" is not a valid export name`);
        }

        const runtimeUrl = `${this.clientPrefix}/external/runtime-dom.js`;

        return `<script type="module">` +
            `import { hydrate } from ${this.#scriptString(runtimeUrl)};` +
            `import { ${name} } from ${this.#scriptString(moduleUrl)};` +
            `hydrate(() => ${name}(window.__slimProps), document.getElementById("slim-root"));` +
            `</script>`;
    }

	page(path: string, render: function, options?: object) {
		let additionalScript = ""
		let titleScript = ""
		let scriptId = 0;
		const scriptString = value => this.#scriptString(value);

		func renderTag(content: string[]) {
			const tags: object = {
				"css": {
					tag: "link",
					attr: "href",
					additionalAttrs: {
						rel: "stylesheet"
					}
				},
				"js": {
					tag: "script",
					attr: "src"
				},
			}

			content.forEach(c => {
			    const assetName = (c.split(/[?#]/)[0] ?? "").split("/").pop() ?? "";
			    const ext = assetName.includes(".") ? (assetName.split(".").pop() ?? "").toLowerCase() : "";

			    if (ext in tags) {
			     	const tag = tags[ext].tag;
				    const attr = tags[ext].attr;
					const varName = `${tag}_${scriptId++}`;
					let additional = ""

					if ("additionalAttrs" in tags[ext]) {
						const additionalAttrs = tags[ext].additionalAttrs

						Object.keys(additionalAttrs).forEach(e => {
							additional += `${varName}.${e} = ${scriptString(additionalAttrs[e])};`
						})
					}

				    additionalScript += `
			       		const ${varName} = document.createElement("${tag}");
						${varName}.${attr} = ${scriptString(c)};
						${additional}
			        	document.head.appendChild(${varName});
					`;
			    }
			});
		}

        if(options) {
            if ("head" in options) {
                const headLinks: string[] = options.head

                renderTag(headLinks)
            }
            if ("title" in options) {
                const title: string = options.title

                titleScript = `document.title = ${scriptString(title)};`
            }
            if ("icon" in options) {
                const icon: string = options.icon

                additionalScript += `
                    link = document.createElement("link");
                    link.rel = "icon";
                    link.href = ${scriptString(icon)};
                    document.head.appendChild(link);
                `
            }
            if ("onload" in options) {
                const onload: function = options.onload

                additionalScript += `
                    const __onload = ${String(onload)};__onload({ port: ${this.port}});
                `
            }
        }

        const hydrating = options ? "hydrate" in options : false;
        const bootstrap = hydrating ? this.#hydrateBootstrap(options?.hydrate) : "";

        this.get(path, async (req, res, params) => {
            const isDev = this.dev
            let html = null

            if (hydrating) {
                const props = { dev: isDev, params, url: req.url }
                const initialStore = "load" in options ? await this.#runLoaders(options.load, props) : null
                const rendered = await renderToStringAsync(() => render(props), { store: initialStore, title: options?.title, url: req.url })
                const data = JSON.stringify(props).replace(/</g, "\\u003c")
                html = `<!doctype html>${rendered.head}<div id="slim-root">${rendered.html}</div>` + rendered.script +
                    `<script>window.__slimProps = ${data}</script>` +
                    bootstrap
            } else {
                html = render({ dev: isDev, params, url: req.url })
            }
			const eventsScript = __flush_events__();

            if(kindof html == "promise") {
                html = await html
            }

            if(kindof html == "object") {
                res.writeHead(200, {
                    "Content-Type": "application/json; charset=utf-8",
                    "Cache-Control": "no-store"
                });
                res.end(JSON.stringify(html))

                return
            }

			html += `<script>`

			html += additionalScript

            if (!hydrating) {
                html += titleScript
            }

            if (isDev) {
                html += `
                    (function () {
                        let connectedBefore = false;

                        const es = new EventSource("/__slim_reload__");

                        es.onopen = () => {
                            if (connectedBefore) {
                                location.reload();
                                return;
                            }
                            connectedBefore = true;
                        };

                        es.addEventListener("css", event => {
                            const name = JSON.parse(event.data);
                            const links = [...document.querySelectorAll('link[rel="stylesheet"]')];
                            const named = links.filter(link => new URL(link.href).pathname.split("/").pop() == name);
                            for (const link of named.length ? named : links) {
                                const url = new URL(link.href);
                                url.searchParams.set("slim-css", String(Date.now()));
                                const next = link.cloneNode();
                                next.href = url.href;
                                next.onload = next.onerror = () => link.remove();
                                link.after(next);
                            }
                        });
                    })();`;
			}

            html += `</script>`

            if (eventsScript) {
                html += `<script>${eventsScript}</script>`
            }

            res.writeHead(200, {
                "Content-Type": "text/html; charset=utf-8",
                "Cache-Control": "no-store"
            });

            res.end(html);
        });
    }

    get(path: string, callback: function) {
        const compiled = this.compileRoute(path);
        this.routes.push({ regex: compiled.regex, keys: compiled.keys, rest: compiled.rest, callback });
    }

    escapeRegex(str: string) {
        const specials = ".^$*+?()[]{}|\\";
        let out = "";

        for (const ch of str) {
            if (specials.includes(ch)) out += "\\";
            out += ch;
        }

        return out;
    }

    compileRoute(route: string) {
        const keys = [];
        let rest = false;

        const pattern = route.split("/").map(segment => {
            if (segment.length > 5 && segment.startsWith("{...") && segment.endsWith("}")) {
                keys.push(segment.slice(4, -1));
                rest = true;
                return "(.*)";
            }

            if (segment.length > 2 && segment.startsWith("{") && segment.endsWith("}")) {
                keys.push(segment.slice(1, -1));
                return "([^/]+)";
            }

            return this.escapeRegex(segment);
        }).join("/");

        return { regex: new RegExp("^" + pattern + "$"), keys, rest };
    }

    contentType(file: string) {
        const types: object = {
            html: "text/html",
            css: "text/css",
            js: "text/javascript",
            mjs: "text/javascript",
            json: "application/json",
            map: "application/json",
            svg: "image/svg+xml",
            png: "image/png",
            jpg: "image/jpeg",
            jpeg: "image/jpeg",
            gif: "image/gif",
            webp: "image/webp",
            ico: "image/x-icon",
            woff: "font/woff",
            woff2: "font/woff2",
            ttf: "font/ttf",
            otf: "font/otf",
            txt: "text/plain",
            htm: "text/html",
            xml: "application/xml",
            webmanifest: "application/manifest+json",
            wasm: "application/wasm",
            avif: "image/avif",
            pdf: "application/pdf",
            mp3: "audio/mpeg",
            mp4: "video/mp4",
            webm: "video/webm"
        };

        const name = nodePath.basename(file);
        const ext = name.includes(".") ? (name.split(".").pop() ?? "").toLowerCase() : "";
        const mime = types[ext] ?? "application/octet-stream";
        const isText = mime.startsWith("text/") || mime == "application/json" || mime == "image/svg+xml" ||
            mime == "application/xml" || mime == "application/manifest+json";

        return isText ? `${mime}; charset=utf-8` : mime;
    }

    colorStatus(status: int) {
        const text = String(status);

        if (!process.stdout.isTTY) return text;

        const esc = String.fromCharCode(27);
        let color = "32";

        if (status >= 500) color = "31";
        else if (status >= 400) color = "33";
        else if (status >= 300) color = "36";

        return `${esc}[${color}m${text}${esc}[0m`;
    }

    api(path: string, handler: function, options?: object) {
        const limit = options && typeof options.limit == "number" && options.limit >= 0 ? options.limit : null;
        this.apiRoutes[path] = { handler, limit };
    }

    redirect(paths: object[]) {
        for(const path of paths) {
            if(empty path) continue

            RedirectRoute.verify(path)

            const from = path.from
            const location = path.to.replace(/[^\x21-\x7E]/g, ch => encodeURIComponent(ch))

            this.get(from, (req, res) => {
                res.writeHead(302, {
                    "Location": location,
                    "Content-Type": "text/plain; charset=utf-8",
                    "Cache-Control": "no-store"
                });

                res.end(`Redirecting to ${location}`);
            })
        }
    }

    static(paths: object[]) {
        for(const path of paths) {
            if(empty path) continue

            StaticRoute.verify(path)

            const from = path.from
            const to = path.to

            const root = nodePath.resolve(to);

            if (!fs.existsSync(root)) {
                log(`[SlimServer] Static setup ("${from}" -> "${to}"): directory not found: ${to}`);
            }

            this.staticDirs.push({ prefix: this.#mountPrefix(from), dir: to });
        }
    }

    #mountPrefix(from: string) {
        let prefix = from.trim();

        if (!prefix.startsWith("/")) prefix = "/" + prefix;
        while (prefix.endsWith("/")) prefix = prefix.slice(0, -1);

        return prefix;
    }

    #cacheControl() {
        return this.dev ? "no-store" : "no-cache";
    }

    #send(res, status: int, body: string, headers?: object) {
        if (res.headersSent) {
            try { res.end(); } catch (x) {}
            return;
        }

        res.writeHead(status, {
            "Content-Type": "text/plain; charset=utf-8",
            "Cache-Control": "no-store",
            ...(headers ?? {})
        });
        res.end(body);
    }

    #runRoute(route, req, res, params) {
        const failed = e => {
            error(`[SlimServer] ${req.method} ${req.url} failed:`, e && e.stack ? e.stack : e);
            this.#send(res, 500, "500 Internal Server Error");
        };

        try {
            const result = route.callback(req, res, params);

            if (result && typeof result.then == "function") result.then(null, failed);
        } catch (e) {
            failed(e);
        }
    }

    #reload(req, res) {
        res.writeHead(200, {
            "Content-Type": "text/event-stream",
            "Cache-Control": "no-cache",
            "Connection": "keep-alive"
        });

        res.write("retry: 300\n\n");

        this.clients.push(res);

        req.on("close", () => {
            this.clients = this.clients.filter(x => x !== res);
        });
    }

    #sendFile(req, res, file: string, stat) {
        const size = stat.size;
        const etag = `W/"${size.toString(16)}-${Math.floor(stat.mtimeMs).toString(16)}"`;
        const lastModified = new Date(stat.mtimeMs).toUTCString();
        const headers: object = {
            "Content-Type": this.contentType(file),
            "Cache-Control": this.#cacheControl(),
            "ETag": etag,
            "Last-Modified": lastModified,
            "Accept-Ranges": "bytes"
        };

        const match = req.headers["if-none-match"];
        const since = req.headers["if-modified-since"];
        let fresh = false;

        if (typeof match == "string") {
            fresh = match.split(",").map(tag => tag.trim()).some(tag => tag == "*" || tag == etag || tag == etag.slice(2));
        } else if (typeof since == "string") {
            const time = Date.parse(since);
            fresh = !Number.isNaN(time) && time >= Math.floor(stat.mtimeMs / 1000) * 1000;
        }

        if (fresh) {
            res.writeHead(304, { "ETag": etag, "Last-Modified": lastModified, "Cache-Control": this.#cacheControl() });
            res.end();
            return;
        }

        let start = 0;
        let end = size - 1;
        let status = 200;
        const range = req.headers.range;

        if (typeof range == "string") {
            const found = /^bytes=(\d*)-(\d*)$/.exec(range.trim());

            if (found && (found[1] != "" || found[2] != "")) {
                if (found[1] == "") {
                    start = Math.max(0, size - Number(found[2]));
                    if (Number(found[2]) == 0) start = size;
                } else {
                    start = Number(found[1]);
                    if (found[2] != "") end = Math.min(Number(found[2]), size - 1);
                }

                if (start >= size || start > end) {
                    res.writeHead(416, {
                        "Content-Range": `bytes */${size}`,
                        "Content-Type": "text/plain; charset=utf-8",
                        "Cache-Control": "no-store"
                    });
                    res.end("416 Range Not Satisfiable");
                    return;
                }

                status = 206;
                headers["Content-Range"] = `bytes ${start}-${end}/${size}`;
            }
        }

        headers["Content-Length"] = size == 0 ? 0 : end - start + 1;
        res.writeHead(status, headers);

        if (req.method == "HEAD" || size == 0) {
            res.end();
            return;
        }

        const stream = fs.createReadStream(file, { start, end });

        stream.on("error", e => {
            error(`[SlimServer] Can't read ${file}:`, e && e.message ? e.message : e);
            res.destroy();
        });

        stream.pipe(res);
    }

    #serveFile(req, res, filePath: string, allowIndex: bool) {
        const notFound = () => this.#send(res, 404, "404 Not Found");

        fs.promises.stat(filePath).then(stat => {
            if (stat.isFile()) {
                this.#sendFile(req, res, filePath, stat);
                return;
            }

            if (!stat.isDirectory() || !allowIndex) {
                notFound();
                return;
            }

            const question = req.url.indexOf("?");
            const pathname = question == -1 ? req.url : req.url.slice(0, question);
            const query = question == -1 ? "" : req.url.slice(question);

            if (!pathname.endsWith("/")) {
                res.writeHead(301, {
                    "Location": "/" + pathname.replace(/^\/+/, "") + "/" + query,
                    "Content-Type": "text/plain; charset=utf-8",
                    "Cache-Control": this.#cacheControl()
                });
                res.end();
                return;
            }

            const index = nodePath.join(filePath, "index.html");

            return fs.promises.stat(index).then(indexStat => {
                if (indexStat.isFile()) this.#sendFile(req, res, index, indexStat);
                else notFound();
            });
        }).catch(() => notFound());
    }

    #serveStatic(mount, url: string, req, res) {
        let relative = url.slice(mount.prefix.length);

        try {
            relative = decodeURIComponent(relative);
        } catch (e) {
            this.#send(res, 400, "400 Bad Request");
            return;
        }

        if (relative.includes("\0")) {
            this.#send(res, 400, "400 Bad Request");
            return;
        }

        while (relative.startsWith("/") || relative.startsWith("\\")) relative = relative.slice(1);

        const root = nodePath.resolve(mount.dir);
        const filePath = nodePath.resolve(root, relative);

        if (filePath != root && !filePath.startsWith(root + nodePath.sep)) {
            this.#send(res, 403, "403 Forbidden");
            return;
        }

        if (mount.client) {
            const rel = nodePath.relative(root, filePath).split(nodePath.sep).join("/");
            let allowed = false;

            try {
                allowed = this.#isClientFile(rel);
            } catch (e) {
                this.#send(res, 500, "500 Internal Server Error");
                return;
            }

            if (!allowed) {
                this.#send(res, 404, "404 Not Found");
                return;
            }
        }

        this.#serveFile(req, res, filePath, !mount.client);
    }

    #handleApi(api, req, res) {
        const limit = api.limit ?? this.bodyLimit;
        const declared = Number(req.headers["content-length"]);
        let rejected = false;

        const tooLarge = () => {
            rejected = true;
            res.writeHead(413, { "Content-Type": "application/json; charset=utf-8" });
            res.end(JSON.stringify({ error: `Request body is larger than ${limit} bytes` }));
            req.resume();
        };

        if (Number.isFinite(declared) && declared > limit) {
            tooLarge();
            return;
        }

        const chunks = [];
        let size = 0;

        req.on("data", chunk => {
            if (rejected) return;

            size += chunk.length;

            if (size > limit) {
                chunks.length = 0;
                tooLarge();
                return;
            }

            chunks.push(chunk);
        });

        req.on("end", async () => {
            if (rejected) return;

            const body = Buffer.concat(chunks).toString("utf8");
            let data = null;

            if (body) {
                try {
                    data = JSON.parse(body);
                } catch (e) {
                    res.writeHead(400, { "Content-Type": "application/json; charset=utf-8" });
                    res.end(JSON.stringify({ error: "Invalid JSON body" }));
                    return;
                }
            }

            try {
                const result = await api.handler(data, req);
                res.writeHead(200, { "Content-Type": "application/json; charset=utf-8" });
                res.end(JSON.stringify(result ?? null));
            } catch (e) {
                error(`[SlimServer] ${req.method} ${req.url} failed:`, e && e.stack ? e.stack : e);
                if (res.headersSent) {
                    try { res.end(); } catch (x) {}
                    return;
                }
                res.writeHead(500, { "Content-Type": "application/json; charset=utf-8" });
                res.end(JSON.stringify({ error: e && e.message ? e.message : String(e) }));
            }
        });
    }

    #handle(req, res) {
        const url = req.url.split("?")[0];
        const readable = req.method == "GET" || req.method == "HEAD";

        if (url == "/__slim_reload__") {
            if (this.dev && readable) this.#reload(req, res);
            else this.#send(res, 404, "404 Not Found");
            return;
        }

        if (this.dev) {
            const started = Date.now();

            res.on("finish", () => {
                const ms = Date.now() - started;
                log(`${req.method} ${req.url} ${this.colorStatus(res.statusCode)} in ${ms}ms`);
            });
        }

        let routed = false;

        for (const route of this.routes) {
            if (route.rest) continue;
            const match = url.match(route.regex);

            if (!match) continue;

            if (!readable) {
                routed = true;
                break;
            }

            const params: object = {};

            try {
                route.keys.forEach((key, i) => {
                    params[key] = decodeURIComponent(match[i + 1]);
                });
            } catch (e) {
                this.#send(res, 400, "400 Bad Request");
                return;
            }

            this.#runRoute(route, req, res, params);
            return;
        }

        const apiRoute = Object.hasOwn(this.apiRoutes, url) ? this.apiRoutes[url] : null;

        if (apiRoute) {
            this.#handleApi(apiRoute, req, res);
            return;
        }

        if (routed) {
            this.#send(res, 405, "405 Method Not Allowed", { "Allow": "GET, HEAD" });
            return;
        }

        const mounts = [...this.staticDirs].sort((a, b) => b.prefix.length - a.prefix.length);

        for (const mount of mounts) {
            if (url == mount.prefix || url.startsWith(mount.prefix + "/")) {
                if (!readable) {
                    this.#send(res, 405, "405 Method Not Allowed", { "Allow": "GET, HEAD" });
                    return;
                }

                this.#serveStatic(mount, url, req, res);
                return;
            }
        }

        for (const route of this.routes) {
            if (!route.rest || !readable) continue;
            const match = url.match(route.regex);
            if (!match) continue;
            const params: object = {};
            try {
                route.keys.forEach((key, i) => {
                    params[key] = decodeURIComponent(match[i + 1]);
                });
            } catch (e) {
                this.#send(res, 400, "400 Bad Request");
                return;
            }
            this.#runRoute(route, req, res, params);
            return;
        }

        this.#send(res, 404, "404 Not Found");
    }

    start() {
        this.httpServer = http.createServer((req, res) => {
            try {
                this.#handle(req, res);
            } catch (e) {
                error(`[SlimServer] ${req.method} ${req.url} failed:`, e && e.stack ? e.stack : e);
                this.#send(res, 500, "500 Internal Server Error");
            }
        });

        this.httpServer.on("error", (err) => {
            if (err && err.code == "EADDRINUSE") {
                error(`Port ${this.port} is already in use — another server (or a previous run) is still holding it.`);
                process.exit(1);
            }
            throw err;
        });

        this.httpServer.listen(this.port, () => {
            log(`http://localhost:${this.port}`);
        });

        if (this.dev && process.send) {
            process.on("message", message => {
                if (!message || typeof message.slimCss != "string") return
                const event = `event: css\ndata: ${JSON.stringify(message.slimCss)}\n\n`
                this.clients.forEach(client => client.write(event))
            })
        }

        this.#installShutdown();
    }

    stop() {
        for (const res of this.clients) {
            try { res.end(); } catch (e) {}
        }
        this.clients = [];

        if (this.httpServer) {
            if (typeof this.httpServer.closeAllConnections == "function") {
                this.httpServer.closeAllConnections();
            }
            this.httpServer.close();
            this.httpServer = null;
        }
    }

    #installShutdown() {
        if (this.shutdownInstalled) return;
        this.shutdownInstalled = true;

        const shutdown = () => {
            this.stop();
            process.exit(0);
        };

        process.on("SIGINT", shutdown);
        process.on("SIGTERM", shutdown);
    }
}

export { Server };
